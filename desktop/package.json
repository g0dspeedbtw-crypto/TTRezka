{
  "name": "tikcut-studio",
  "productName": "TikCut Studio",
  "version": "2.4.0",
  "author": "TikCut Studio",
  "description": "Локальное десктопное приложение для TikTok нарезок 9:16 с ИИ-анализом и авто-субтитрами",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg zip dir --publish never",
    "build:win": "electron-builder --win nsis portable --publish never",
    "publish:mac": "electron-builder --mac dmg zip --publish always",
    "publish:win": "electron-builder --win nsis portable --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tikcut.studio",
    "productName": "TikCut Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "g0dspeedbtw-crypto",
        "repo": "TTRezka",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend-dist",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        },
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ]
    },
    "dmg": {
      "title": "TikCut Studio",
      "icon": "assets/icon.png"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "TikCut Studio"
    }
  }
}
